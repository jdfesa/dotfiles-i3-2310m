# Based on mmarfil/magic-trackpad-battery (MIT; see vendor/LICENSE).
# Grant only the active local seat access to the Bluetooth Magic Trackpad 2.
# Apply before 73-seat-late.rules; keep every other hidraw device restricted.
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", KERNELS=="0005:004C:0265.*", DRIVERS=="magicmouse", ENV{ID_SEAT}="seat0", TAG+="uaccess"

# Tag only this Bluetooth touchpad for native Xorg pointer speed.
# ID_INPUT.tags is read by Xorg; preserve other tags and avoid duplicates.
SUBSYSTEM=="input", KERNEL=="event[0-9]*", KERNELS=="0005:004C:0265.*", DRIVERS=="magicmouse", ENV{ID_INPUT_TOUCHPAD}=="1", ENV{ID_INPUT.tags}=="", ENV{ID_INPUT.tags}="bgh-magic-trackpad-2-bluetooth"
SUBSYSTEM=="input", KERNEL=="event[0-9]*", KERNELS=="0005:004C:0265.*", DRIVERS=="magicmouse", ENV{ID_INPUT_TOUCHPAD}=="1", ENV{ID_INPUT.tags}!="", ENV{ID_INPUT.tags}!="*bgh-magic-trackpad-2-bluetooth*", ENV{ID_INPUT.tags}="$env{ID_INPUT.tags},bgh-magic-trackpad-2-bluetooth"
