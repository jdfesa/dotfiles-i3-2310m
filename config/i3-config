# Minimal i3 configuration for the BGH A470 (jd).
# Super/Windows is the main modifier; no compositor or desktop autostart.
set $mod Mod4
font pango:JetBrainsMono Nerd Font Mono 10
floating_modifier $mod
focus_follows_mouse no
default_border pixel 2
hide_edge_borders smart

# Catppuccin Mocha without compositor effects.
#                    border  background text    indicator child_border
client.focused       #b4befe #45475a #cdd6f4 #b4befe #b4befe
client.focused_inactive #313244 #1e1e2e #a6adc8 #313244 #313244
client.unfocused     #181825 #181825 #7f849c #181825 #181825
client.urgent        #f38ba8 #f38ba8 #11111b #f38ba8 #f38ba8
client.background    #1e1e2e

# A compact, keyboard-accessible network list, rather than a tiled terminal.
for_window [class="^BGH-Networks$"] floating enable, resize set 760 520, move position center
for_window [class="^BGH-Mixer$"] floating enable, resize set 760 520, move position center
for_window [class="^BGH-Updates$"] floating enable, resize set 850 520, move position center
for_window [class="^BGH-Power$"] floating enable, resize set 760 360, move position center

# Applications and session controls.
bindsym $mod+Return exec --no-startup-id kitty
bindsym $mod+space exec --no-startup-id rofi -show drun
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+n exec --no-startup-id ~/scripts/open-networks.sh
bindsym $mod+a exec --no-startup-id ~/scripts/open-mixer.sh
bindsym $mod+u exec --no-startup-id ~/scripts/open-updates.sh
bindsym $mod+Shift+p exec --no-startup-id ~/scripts/power-menu
bindsym $mod+Shift+Return exec --no-startup-id helium
bindsym $mod+Shift+b exec --no-startup-id helium
bindsym $mod+k exec --no-startup-id rofi -dmenu -i -p 'Shortcuts' < ~/.config/i3/keybindings-help.txt >/dev/null
bindsym $mod+w kill
bindsym $mod+q kill
bindsym $mod+Shift+q kill
bindsym $mod+Control+l exec --no-startup-id i3lock -c 202020
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e mode "Exit session? Y=yes, N/Escape=cancel"
mode "Exit session? Y=yes, N/Escape=cancel" {
    bindsym y exit
    bindsym n mode "default"
    bindsym Escape mode "default"
}

# Focus: Omarchy-style arrows. J/K/L are reserved for layouts/help.
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move the selected window.
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Layouts and floating windows.
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+j layout toggle split
bindsym $mod+l layout toggle split tabbed stacking
bindsym $mod+Control+s layout stacking
bindsym $mod+Control+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Tab focus mode_toggle
bindsym $mod+t floating toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+s scratchpad show
bindsym $mod+Mod1+s move scratchpad

# Workspaces.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Resize mode: Enter or Escape returns to normal bindings.
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bar {
    position top
    status_command ~/scripts/status-clicks.py
    font pango:JetBrainsMono Nerd Font Mono 10
    workspace_buttons yes
    workspace_min_width 24
    binding_mode_indicator yes
    separator_symbol "│"
    colors {
        background #1e1e2e
        statusline #cdd6f4
        separator #45475a
        #                border  background text
        focused_workspace #45475a #45475a #b4befe
        active_workspace  #313244 #313244 #cdd6f4
        inactive_workspace #1e1e2e #1e1e2e #7f849c
        urgent_workspace #f38ba8 #f38ba8 #11111b
        binding_mode #b4befe #45475a #b4befe
    }
}
