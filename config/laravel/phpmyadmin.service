[Unit]
Description=Local phpMyAdmin development server
Requires=mariadb.service
After=mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=/usr/bin/php8.4 -S 127.0.0.1:8080 -t /usr/share/phpmyadmin /usr/local/share/bgh-laravel/phpmyadmin-router.php
WorkingDirectory=/usr/share/phpmyadmin
Environment=LANG=en_US.UTF-8
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/php/sessions /var/lib/phpmyadmin
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# No Install section: start explicitly; never enable at boot.
